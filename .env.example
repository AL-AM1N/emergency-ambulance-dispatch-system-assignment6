NODE_ENV=development
PORT=5000

# PostgreSQL connection string. Local example below — replace with your own.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ambulance_dispatch?schema=public"

JWT_ACCESS_SECRET=e077e5e5dffe46d3b1684624a350a88c9c5286d1240853c07e7529e18f7c80a2
JWT_REFRESH_SECRET=883b517a1ae41b1b460d5eef6d3b329f2fbc56a35317671253425a05da584b6c
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Used to build absolute links back to this API.
BACKEND_URL=http://localhost:5000

# Allowed CORS origin for the browser client.
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 client id used to verify idTokens on the /auth/google endpoint.
GOOGLE_CLIENT_ID=your_google_client_id

# Admin (dispatcher) account seeded on server start.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# Stripe payment keys (test keys work in sandbox mode).
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
